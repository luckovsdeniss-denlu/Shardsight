static var _cache := {}


## The icon called `icon` (an ImageTexture, drawn at 16 x 16 and stored at 64 x 64), "dot" if there's no such picture.
static func tex(icon: String) -> Texture2D:
	if _cache.has(icon):
		return _cache[icon]
	var rows: Array = PICS.get(icon, PICS["dot"])
	var img := Image.create(16, 16, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in range(mini(rows.size(), 16)):
		var row := String(rows[y])
		for x in range(mini(row.length(), 16)):
			var ch := row[x]
			if PALETTE.has(ch):
				img.set_pixel(x, y, PALETTE[ch])
	img.resize(64, 64, Image.INTERPOLATE_NEAREST)   # blown up with hard edges: stays crisp when drawn smaller
	var t := ImageTexture.create_from_image(img)
	_cache[icon] = t
	return t


## The icon for an item in the bag.
static func for_item(id: String) -> String:
	if Items.is_map(id):
		return "map"
	if Jewelry.has(id) or id == "cave_crystal" or id == "pearl" or Gems.is_gem(id):
		return "gem"
	if id in ["wheat", "carrot", "pumpkin", "swamp_herb"]:
		return "crop"
	match Art.item_category(id):
		"weapon":
			return "weapon"
		"armor":
			return "armor"
		"shield":
			return "shield"
		"potion":
			return "potion"
		"food":
			return "food"
		"tool", "instrument":
			return "tool"
		"scroll":
			return "scroll"
		"metal", "log", "pelt":
			return "material"
		"gold":
			return "coin"
	return "chest"
